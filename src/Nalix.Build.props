<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<!-- Packing -->
		<IsPackable>true</IsPackable>
		<OutputType>Library</OutputType>
		<Deterministic>true</Deterministic>

		<!-- Package metadata -->
		<Product>Nalix® .NET</Product>
		<Authors>PPN Systems</Authors>
		<Company>PPN Systems</Company>
		<RepositoryType>git</RepositoryType>
		<NeutralLanguage>en-US</NeutralLanguage>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PackageIcon>nalix.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryUrl>https://github.com/ppn-systems/Nalix</RepositoryUrl>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://docs.ppnsys.com</PackageProjectUrl>
		<Copyright>Copyright (c) 2025-2026 PPN Systems. All rights reserved.</Copyright>
	</PropertyGroup>

	<PropertyGroup Label="Assembly Properties">
		<DebugSymbols>true</DebugSymbols>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
	</PropertyGroup>

</Project>
