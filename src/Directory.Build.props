<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Version.props') AND '$(Version)' == ''" />

	<PropertyGroup>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>embedded</DebugType>
		<IncludeSource>false</IncludeSource>
		<IncludeSymbols>false</IncludeSymbols>
		<PublishRepositoryUrl>false</PublishRepositoryUrl>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<OutputPath>$(MSBuildThisFileDirectory)..\build\bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<Deterministic>true</Deterministic>
		<TieredCompilation>true</TieredCompilation>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<UseSharedCompilation Condition="'$(ContinuousIntegrationBuild)' == 'true'">false</UseSharedCompilation>
		<GenerateDepsFile Condition="'$(OutputType)' == 'Library'">false</GenerateDepsFile>
		<OutputPath>$(MSBuildThisFileDirectory)..\build\bin\$(Configuration)\$(MSBuildProjectName)\</OutputPath>

		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<FileVersion Condition="'$(FileVersion)' == ''">$(Version).0</FileVersion>
		<InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)+$(SourceRevisionId)</InformationalVersion>
	</PropertyGroup>
	
	<!--
		Internals are visible to the test and benchmark assemblies in every configuration, so Debug and Release
		exercise the same tests. A strong-name-signed assembly cannot grant IVT by simple name (CS1726) and a
		shipped package should not expose internals anyway, so signed builds skip the grant. Test and analysis
		builds must therefore stay unsigned (they do not need the signing key).
	-->
	<ItemGroup Condition="'$(SignAssembly)' != 'true' And '$(MSBuildProjectName)' != 'Nalix.Analyzers' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Generators'">
		<InternalsVisibleTo Include="Nalix.Abstractions.Tests" />
		<InternalsVisibleTo Include="Nalix.Codec.Tests" />
		<InternalsVisibleTo Include="Nalix.Environment.Tests" />
		<InternalsVisibleTo Include="Nalix.Framework.Tests" />
		<InternalsVisibleTo Include="Nalix.Hosting.Tests" />
		<InternalsVisibleTo Include="Nalix.Integration.Tests" />
		<InternalsVisibleTo Include="Nalix.Network.Tests" />
		<InternalsVisibleTo Include="Nalix.Runtime.Tests" />
		<InternalsVisibleTo Include="Nalix.SDK.Tests" />
		<InternalsVisibleTo Include="Nalix.Codec.Benchmarks" />
		<InternalsVisibleTo Include="Nalix.Framework.Benchmarks" />
		<InternalsVisibleTo Include="Nalix.Network.Benchmarks" />
		<InternalsVisibleTo Include="Nalix.Runtime.Benchmarks" />
	</ItemGroup>

	<ItemGroup Condition="'$(PublishAot)' != 'true' And '$(DisableNalixAnalyzers)' != 'true' And '$(MSBuildProjectName)' != 'Nalix.Analyzers' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Tests'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\analyzers\Nalix.Analyzers\Nalix.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" AdditionalProperties="Configuration=$(Configuration)" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\analyzers\Nalix.Analyzers.CodeFixes\Nalix.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" AdditionalProperties="Configuration=$(Configuration)" />
	</ItemGroup>

	<!-- Source generator for ConfigurationLoader AOT binding and singleton activator registration -->
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Nalix.Analyzers' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.CodeFixes' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Tests' And '$(MSBuildProjectName)' != 'Nalix.Analyzers.Generators' And '$(MSBuildProjectName)' != 'Nalix.Abstractions'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\analyzers\Nalix.Analyzers.Generators\Nalix.Analyzers.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" AdditionalProperties="Configuration=$(Configuration)" />
	</ItemGroup>

</Project>
