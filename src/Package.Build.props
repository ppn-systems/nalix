<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup Label="Package Properties" Condition="'$(Configuration)' == 'Release'">
		<RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\</RepositoryRoot>

		<PackageTags>Nalix,.NET 10,library,network,security</PackageTags>
		<SignAssembly Condition="'$(AssemblyOriginatorKeyFile)' != ''">true</SignAssembly>
		<AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)Nalix.snk')">$(MSBuildThisFileDirectory)Nalix.snk</AssemblyOriginatorKeyFile>
		<AssemblyOriginatorKeyFile Condition="'$(AssemblyOriginatorKeyFile)' == '' AND Exists('$(RepositoryRoot)Nalix.snk')">$(RepositoryRoot)Nalix.snk</AssemblyOriginatorKeyFile>

		<DebugType>portable</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup Label="Package Properties">
		<None Include="..\..\LICENSE" Condition="'$(Configuration)' == 'Release'">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)\README.md') AND '$(Configuration)' != 'Debug'" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" Condition="!Exists('$(MSBuildProjectDirectory)\README.md') AND Exists('..\..\README.md') AND '$(Configuration)' != 'Debug'" />
		<None Include="..\..\assets\nalix.png" Pack="true" PackagePath="\" Condition="Exists('..\..\assets\nalix.png') AND '$(Configuration)' != 'Debug'" />
	</ItemGroup>
</Project>
