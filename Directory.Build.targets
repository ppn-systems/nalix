<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
		Tracks the public API of every NuGet-packaged project (IsPackable=true) with
		Microsoft.CodeAnalysis.PublicApiAnalyzers. Each such project keeps PublicAPI.Shipped.txt
		(API of released versions) and PublicAPI.Unshipped.txt (API added since the last release).
		Non-packable projects (tests, benchmarks, samples, analyzers) are not affected.
		See CONTRIBUTING.md ("Public API tracking") for the update workflow.
	-->
	<PropertyGroup>
		<_NalixIsPublicApiProject Condition="'$(IsPackable)' == 'true'">true</_NalixIsPublicApiProject>
	</PropertyGroup>

	<ItemGroup Condition="'$(_NalixIsPublicApiProject)' == 'true'">
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<!--
		Optional: build and run the multi-targeted test projects for one framework only, e.g.
		dotnet test tests/Nalix.Tests.sln -p:TestTargetFramework=net10.0
		CI tests one framework and compiles src for every framework separately. Unset, nothing changes.
		(dotnet build -f does not work on the solutions: the analyzer projects are netstandard2.0 only.)
	-->
	<PropertyGroup Condition="'$(TestTargetFramework)' != '' And '$(IsTestProject)' == 'true' And '$(TargetFrameworks)' != ''">
		<TargetFrameworks>$(TestTargetFramework)</TargetFrameworks>
	</PropertyGroup>

</Project>
