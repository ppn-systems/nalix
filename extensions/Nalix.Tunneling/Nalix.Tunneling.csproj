<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nalix.Tunneling.Tests" Condition="'$(NalixInternalsVisibleTo)' != 'false'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nalix.Abstractions\Nalix.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Nalix.Framework\Nalix.Framework.csproj" />
    <ProjectReference Include="..\..\src\Nalix.Hosting\Nalix.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Nalix.Runtime\Nalix.Runtime.csproj" />
    <ProjectReference Include="..\Nalix.Tunneling.Contracts\Nalix.Tunneling.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <!-- Source generator for [PacketHandler] handler registration -->
  <ItemGroup>
    <ProjectReference Include="..\..\analyzers\Nalix.Analyzers.Generators\Nalix.Analyzers.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;IsTrimmable;IsAotCompatible;RuntimeIdentifier;RuntimeIdentifiers" />
  </ItemGroup>

</Project>
